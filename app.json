{
  "expo": {
    "name": "BackForge AI",
    "slug": "back-forgeai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "backforgeai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F7F8FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rasheq462003.backforge.ai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "BackForge uses the microphone so you can talk items in.",
        "NSSpeechRecognitionUsageDescription": "BackForge turns what you say into a to-do or reminder.",
        "NSUserNotificationsUsageDescription": "BackForge sends reminders for items that need you."
      },
      "appleTeamId": "KDU25W2MCD"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#F7F8FA",
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "splash": {
        "resizeMode": "contain",
        "backgroundColor": "#F7F8FA",
        "dark": {
          "backgroundColor": "#F7F8FA"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rasheq462003.backforge.ai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA",
          "dark": {
            "backgroundColor": "#F7F8FA"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0F766E"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "BackForge uses the microphone so you can talk items in.",
          "speechRecognitionPermission": "BackForge turns what you say into a to-do or reminder."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c76d637-2330-40bb-8e0c-aa6c78f6b633"
      }
    },
    "owner": "mohamed_rasheq"
  }
}
